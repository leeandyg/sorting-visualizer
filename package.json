{
  "name": "sorting-visualizer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w visualizer",
    "dev:sortify": "npm run dev -w sortify",
    "build": "npm run build -w visualizer -w sortify",
